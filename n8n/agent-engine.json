        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify({ structuredQuery: { from: [{ collectionId: 'messages' }], where: { fieldFilter: { field: { fieldPath: 'conversationId' }, op: 'EQUAL', value: { stringValue: $('Webhook mensaje').item.json.body.conversationId } } }, orderBy: [{ field: { fieldPath: 'timestamp' }, direction: 'DESCENDING' }], limit: (($json.fields && $json.fields.shortTermWindow && $json.fields.shortTermWindow.integerValue) ? Number($json.fields.shortTermWindow.integerValue) : 10) } }) }}",
