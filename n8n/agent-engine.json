        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "options": {}
      },
      "id": "1f0a0001-0000-4000-8000-000000000005",
      "name": "Leer memoria",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        800,
        0
      ],
      "alwaysOutputData": true
    },
    {
      "parameters": {
        "jsCode": "// Construye la petición a Claude: system prompt + memoria + historial short-term.\nconst agent = $('Leer agente').first().json;\nconst webhookBody = $('Webhook mensaje').first().json.body;\nconst queryRows = $('Leer mensajes').all().map(i => i.json).filter(r => r.document);\nconst memoryDocs = $('Leer memoria').first().json.documents || [];\n\nconst systemPrompt = agent.fields?.systemPrompt?.stringValue || 'Eres un asistente útil.';\nconst facts = memoryDocs\n  .map(d => d.fields?.content?.stringValue)\n  .filter(Boolean);\n\nconst system = facts.length\n  ? `${systemPrompt}\\n\\nMemoria (hechos conocidos sobre este cliente):\\n- ${facts.join('\\n- ')}`\n  : systemPrompt;\n\n// runQuery devuelve DESC → invertir a orden cronológico.\nconst history = queryRows\n  .map(r => ({\n    role: r.document.fields?.role?.stringValue,\n    content: r.document.fields?.content?.stringValue,\n    status: r.document.fields?.status?.stringValue,\n  }))\n  .filter(m => m.role && m.content && m.status !== 'error')\n  .reverse();\n\n// Asegurar que el historial termina con el mensaje actual del usuario.\nif (!history.length || history[history.length - 1].content !== webhookBody.content) {\n  history.push({ role: 'user', content: webhookBody.content });\n}\n\nconst messages = history.map(({ role, content }) => ({ role, content }));\n\nreturn [{\n  json: {\n    claudeRequest: {\n      model: 'claude-sonnet-4-6',\n      max_tokens: 1024,\n      system,\n      messages,\n    },\n  },\n}];"
      },
      "id": "1f0a0001-0000-4000-8000-000000000006",
      "name": "Construir prompt",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1000,
        0
      ]
    },
