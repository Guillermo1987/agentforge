{
  "name": "AgentForge — Memory Consolidation (3am)",
  "nodes": [
    {
      "parameters": {
        "rule": {
          "interval": [
            {
              "field": "cronExpression",
              "expression": "0 3 * * *"
            }
          ]
        }
      },
      "id": "2f0a0002-0000-4000-8000-000000000001",
      "name": "Cron 3am",
      "type": "n8n-nodes-base.scheduleTrigger",
      "typeVersion": 1.2,
      "position": [
        0,
        0
      ]
    },
    {
      "parameters": {
        "url": "https://firestore.googleapis.com/v1/projects/agent-forge-app/databases/(default)/documents/agents?pageSize=300",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "options": {}
      },
      "id": "2f0a0002-0000-4000-8000-000000000002",
      "name": "Listar agentes",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        200,
        0
      ],
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Un item por agente activo: { agentId }\nconst docs = $input.first().json.documents || [];\nreturn docs\n  .filter(d => d.fields?.active?.booleanValue !== false)\n  .map(d => ({ json: { agentId: d.name.split('/').pop() } }));"
      },
      "id": "2f0a0002-0000-4000-8000-000000000003",
      "name": "Un item por agente",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        400,
        0
      ]
    },
    {
      "parameters": {
        "options": {}
      },
      "id": "2f0a0002-0000-4000-8000-000000000004",
      "name": "Loop agentes",
      "type": "n8n-nodes-base.splitInBatches",
      "typeVersion": 3,
      "position": [
        600,
        0
      ]
    },
    {
      "parameters": {
        "url": "=https://firestore.googleapis.com/v1/projects/agent-forge-app/databases/(default)/documents/memory/{{ $json.agentId }}/facts?pageSize=300",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "options": {}
      },
      "id": "2f0a0002-0000-4000-8000-000000000005",
      "name": "Leer facts",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        820,
        100
      ],
      "alwaysOutputData": true,
      "retryOnFail": true
    },
    {
      "parameters": {
        "jsCode": "// Prepara la petición de consolidación. Si hay <2 facts no hay nada que fusionar.\nconst agentId = $('Loop agentes').first().json.agentId;\nconst docs = $input.first().json.documents || [];\nconst facts = docs.map(d => ({\n  id: d.name.split('/').pop(),\n  content: d.fields?.content?.stringValue || '',\n  source: d.fields?.source?.stringValue || 'unknown',\n}));\n\nif (facts.length < 2) {\n  return [{ json: { agentId, skip: true, factIds: [], claudeRequest: null } }];\n}\n\nconst list = facts.map(f => `- ${f.content}`).join('\\n');\nreturn [{\n  json: {\n    agentId,\n    skip: false,\n    factIds: facts.map(f => f.id),\n    claudeRequest: {\n      model: 'claude-sonnet-4-6',\n      max_tokens: 1024,\n      system: 'Eres un consolidador de memoria. Recibes una lista de hechos sobre un cliente. Fusiona duplicados, elimina contradicciones (gana el más reciente, los últimos de la lista), y prioriza lo accionable. Devuelve SOLO un array JSON de strings (máximo 20 hechos, sin texto adicional).',\n      messages: [{ role: 'user', content: `Hechos actuales:\\n${list}` }],\n    },\n  },\n}];"
      },
      "id": "2f0a0002-0000-4000-8000-000000000006",
      "name": "Preparar consolidación",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1040,
        100
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.skip }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2f0a0002-0000-4000-8000-000000000007",
      "name": "¿Hay que consolidar?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1260,
        100
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://api.anthropic.com/v1/messages",
        "authentication": "genericCredentialType",
        "genericAuthType": "httpHeaderAuth",
        "sendHeaders": true,
        "headerParameters": {
          "parameters": [
            {
              "name": "anthropic-version",
              "value": "2023-06-01"
            },
            {
              "name": "content-type",
              "value": "application/json"
            }
          ]
        },
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.claudeRequest) }}",
        "options": {
          "timeout": 60000
        }
      },
      "id": "2f0a0002-0000-4000-8000-000000000008",
      "name": "Claude consolida",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        1480,
        0
      ],
      "onError": "continueRegularOutput",
      "credentials": {
        "httpHeaderAuth": {
          "id": "REEMPLAZAR",
          "name": "Claude API Key (header x-api-key)"
        }
      }
    },
    {
      "parameters": {
        "jsCode": "// Construye el commit Firestore: borra los facts antiguos y escribe los consolidados.\nconst prep = $('Preparar consolidación').first().json;\nconst reply = $input.first().json;\n\nlet newFacts;\ntry {\n  newFacts = JSON.parse(reply.content[0].text);\n  if (!Array.isArray(newFacts)) throw new Error('no es array');\n} catch (e) {\n  // Si Claude no devolvió JSON válido, abortar sin tocar la memoria.\n  return [{ json: { agentId: prep.agentId, aborted: true, reason: String(e) } }];\n}\n\nconst base = `projects/agent-forge-app/databases/(default)/documents/memory/${prep.agentId}/facts`;\nconst writes = [\n  ...prep.factIds.map(id => ({ delete: `${base}/${id}` })),\n  ...newFacts.slice(0, 20).map(content => ({\n    update: {\n      name: `${base}/fact-${Math.random().toString(36).slice(2, 10)}`,\n      fields: {\n        content: { stringValue: String(content) },\n        source: { stringValue: 'consolidation' },\n        createdAt: { timestampValue: new Date().toISOString() },\n      },\n    },\n  })),\n];\n\nreturn [{ json: { aborted: false, commitBody: { writes } } }];"
      },
      "id": "2f0a0002-0000-4000-8000-000000000009",
      "name": "Preparar commit",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        1700,
        0
      ]
    },
    {
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "leftValue": "={{ $json.aborted }}",
              "rightValue": false,
              "operator": {
                "type": "boolean",
                "operation": "equals"
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      },
      "id": "2f0a0002-0000-4000-8000-00000000000a",
      "name": "¿Commit válido?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        1920,
        0
      ]
    },
    {
      "parameters": {
        "method": "POST",
        "url": "https://firestore.googleapis.com/v1/projects/agent-forge-app/databases/(default)/documents:commit",
        "authentication": "predefinedCredentialType",
        "nodeCredentialType": "googleApi",
        "sendBody": true,
        "specifyBody": "json",
        "jsonBody": "={{ JSON.stringify($json.commitBody) }}",
        "options": {}
      },
      "id": "2f0a0002-0000-4000-8000-00000000000b",
      "name": "Commit Firestore",
      "type": "n8n-nodes-base.httpRequest",
      "typeVersion": 4.4,
      "position": [
        2140,
        -80
      ],
      "retryOnFail": true
    }
  ],
