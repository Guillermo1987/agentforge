# Firebase web app (consola Firebase -> Project settings -> General -> Your apps)
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=agent-forge-app.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=agent-forge-app
VITE_FIREBASE_STORAGE_BUCKET=agent-forge-app.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=

# Webhook del Agent Engine (n8n expuesto via cloudflared o VM publica)
# Ej: https://n8n.midominio.com/webhook/agentforge-message
VITE_N8N_WEBHOOK_URL=
